# Copy this file to .env and fill in real values before running:
#   docker compose up -d --build
#
# This single .env is used both by docker compose itself (variable
# substitution in docker-compose.yml) and passed into the app container.

# --- MongoDB (used by the mongodb service + composed into MONGODB_URI below) ---
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-this-strong-password
MONGO_DATABASE=portfolio

# --- Admin credentials (app login) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# --- JWT secret (change this to a long random string in production) ---
JWT_SECRET=your-super-secret-jwt-key-change-this

# --- RustFS / S3-compatible object storage ---
RUSTFS_ENDPOINT=
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=portfolio
RUSTFS_PUBLIC_URL=

# --- krakens analytics ---
NEXT_PUBLIC_KRAKENS_PROJECT_ID=

# --- App ---
APP_PORT=3000
